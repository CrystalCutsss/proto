{
  "$description": "Synthetic DTCG 2025.10 fixture. Replaced by tokens from Proto/DS after ds-sync (Phase 2b).",
  "color": {
    "$type": "color",
    "palette": {
      "neutral-0": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      },
      "neutral-50": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.965, 0.969, 0.976],
          "hex": "#f6f7f9"
        }
      },
      "neutral-200": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.863, 0.871, 0.89],
          "hex": "#dcdee3"
        }
      },
      "neutral-500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.42, 0.447, 0.502],
          "hex": "#6b7280"
        }
      },
      "neutral-900": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.071, 0.082, 0.11],
          "hex": "#12151c"
        }
      },
      "brand-500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.267, 0.341, 0.937],
          "hex": "#4457ef"
        }
      },
      "brand-600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.204, 0.267, 0.816],
          "hex": "#3444d0"
        }
      },
      "green-500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.133, 0.6, 0.38],
          "hex": "#229961"
        }
      },
      "amber-500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.851, 0.565, 0.071],
          "hex": "#d99012"
        }
      },
      "red-500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.851, 0.2, 0.235],
          "hex": "#d9333c"
        }
      }
    },
    "bg": {
      "default": {
        "$value": "{color.palette.neutral-0}"
      },
      "subtle": {
        "$value": "{color.palette.neutral-50}"
      },
      "inverse": {
        "$value": "{color.palette.neutral-900}"
      }
    },
    "fg": {
      "default": {
        "$value": "{color.palette.neutral-900}"
      },
      "muted": {
        "$value": "{color.palette.neutral-500}"
      },
      "inverse": {
        "$value": "{color.palette.neutral-0}"
      },
      "accent": {
        "$value": "{color.palette.brand-500}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.palette.neutral-200}"
      },
      "focus": {
        "$value": "{color.palette.brand-500}"
      }
    },
    "action": {
      "primary": {
        "$value": "{color.palette.brand-500}"
      },
      "primary-hover": {
        "$value": "{color.palette.brand-600}"
      }
    },
    "status": {
      "draft": {
        "$value": "{color.palette.neutral-500}"
      },
      "review": {
        "$value": "{color.palette.amber-500}"
      },
      "frozen": {
        "$value": "{color.palette.green-500}"
      },
      "danger": {
        "$value": "{color.palette.red-500}"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "12": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter Variable", "system-ui", "sans-serif"]
      },
      "mono": {
        "$value": ["ui-monospace", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "md": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 2,
          "unit": "rem"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.5
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.071, 0.082, 0.11],
          "alpha": 0.08,
          "hex": "#12151c"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 8,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 240,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 480,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      },
      "emphasized": {
        "$value": [0.3, 0, 0, 1]
      }
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": {
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "focus": {
        "$value": {
          "value": 2,
          "unit": "px"
        }
      }
    }
  }
}
