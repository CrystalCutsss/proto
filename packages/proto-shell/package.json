{
  "name": "@proto/proto-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime layer of every prototype (ADR-0011, ADR-0020): the loader, the viewer at /p/<slug>/ with the iPhone mockup and the scenario/version menu, and the menu of an installed web app.",
  "exports": {
    "./package.json": "./package.json",
    "./switch": "./src/switch.ts"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@proto/registry": "workspace:*",
    "@proto/tokens": "workspace:*",
    "happy-dom": "21.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@proto/ui": "workspace:*"
  }
}
